# Ключ безопасности Flask
SECRET_KEY=dev-secret-change-me

# Ключ API OpenAI (если используется AI)
OPENAI_API_KEY=your-openai-api-key-here

# Модель OpenAI
OPENAI_MODEL=gpt-5.2

# Использовать AI (true/false)
USE_AI=true

# Язык для Tesseract OCR
TESSERACT_LANG=rus+eng

# DPI для OCR
OCR_DPI=300

# Максимальный размер загружаемого файла (в байтах)
MAX_CONTENT_LENGTH=26214400

# Путь к базе данных (относительно корня проекта)
DATABASE_PATH=instance/documents.db

# Директория для загрузок
UPLOAD_DIR=instance/uploads