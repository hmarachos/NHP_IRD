# Ключ безопасности Flask
SECRET_KEY=dev-secret-change-me

# Ключ API OpenAI (если используется AI)
OPENAI_API_KEY=your-openai-api-key-here

# Модель OpenAI
OPENAI_MODEL=gpt-5.2

# Локальная модель Ollama (ollama или openai)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=90

# Использовать AI (true/false)
USE_AI=true

# Язык для Tesseract OCR
TESSERACT_LANG=rus+eng

# DPI для OCR
OCR_DPI=300

# Максимальный размер загружаемого файла (в байтах)
MAX_CONTENT_LENGTH=26214400
MAX_UPLOAD_FILE_SIZE=26214400

# Внешний порт приложения
APP_PORT=5050

# Путь к базе данных (относительно корня проекта)
DATABASE_PATH=instance/documents.db

# Директория для загрузок
UPLOAD_DIR=instance/uploads
