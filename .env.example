# Django secret key (generate a unique random value for deployment)
SECRET_KEY=replace-this-with-a-unique-random-secret

# Runtime mode
DJANGO_DEBUG=0
DJANGO_APP_PORT=5050
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL 16
DJANGO_POSTGRES_DB=nhp_ird_django
DJANGO_POSTGRES_USER=nhp_ird
DJANGO_POSTGRES_PASSWORD=change-this-password
DJANGO_POSTGRES_BIND_PORT=5438
DJANGO_ENABLE_EMAIL_NOTIFICATIONS=false
LEGACY_SQLITE_SOURCE_PATH=instance/documents.db

# Ключ API OpenAI (если используется AI)
OPENAI_API_KEY=your-openai-api-key-here

# Модель OpenAI
OPENAI_MODEL=gpt-6-luna

# Использовать AI (true/false)
USE_AI=true

# Язык для Tesseract OCR
TESSERACT_LANG=rus+eng

# DPI для OCR
OCR_DPI=300

# Максимальный размер загружаемого файла (в байтах)
# Upload size and file count are unrestricted; large files spool to disk.

# Директория для загрузок
UPLOAD_DIR=instance/uploads

# Gmail SMTP для ежедневных писем (нужен пароль приложения Google)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=
MAIL_RECIPIENT=a.kazantsev@beloil.by
MAIL_TIMEZONE=Europe/Minsk
MAIL_SEND_HOUR=8

# Директория сохранённых актов
ACTS_DIR=instance/acts
